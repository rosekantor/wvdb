/*
 * conf/base.config
 * Per-process CPU / memory defaults.
 * Override individual labels on the SLURM profile or per-cluster config.
 */

process {
    // Global defaults
    cpus   = 4
    memory = '16 GB'
    time   = '4 h'

    withLabel: 'cpu_high' {
        cpus   = params.threads
        memory = '64 GB'
        time   = '12 h'
    }

    withLabel: 'cpu_medium' {
        cpus   = { Math.min(params.threads, 32) }
        memory = '32 GB'
        time   = '6 h'
    }

    withLabel: 'cpu_low' {
        cpus   = 4
        memory = '16 GB'
        time   = '2 h'
    }

    // vclust prefilter / align are the most memory-hungry steps
    withName: 'VCLUST_PREFILTER|VCLUST_ALIGN|VCLUST_PREFILTER_RECLUST|VCLUST_ALIGN_RECLUST' {
        label  = 'cpu_high'
    }

    withName: 'MINIMAP2_PAIRWISE' {
        label = 'cpu_high'
    }

    withName: 'BLASTN|BLASTN_METAVR' {
        label = 'cpu_high'
    }

    withName: 'CHECKV' {
        label  = 'cpu_medium'
    }
}

/*
 * conf/base.config
 * Per-process CPU / memory defaults.
 *
 * All memory values driven by params so they can be overridden at runtime:
 *   --max_memory      caps high/medium processes  (default: 64 GB)
 *   --max_memory_low  caps low-CPU processes       (default: 16 GB)
 *   --max_time        caps all process runtimes    (default: 24 h)
 *
 * Override for a specific cluster:
 *   nextflow run main.nf --max_memory '120 GB' --max_memory_low '8 GB'
 * Or add a cluster-specific profile in nextflow.config.
 */

process {
    // Global defaults (catch-all for unlabelled processes)
    cpus   = 2
    memory = { params.max_memory_low }
    time   = { params.max_time }

    withLabel: 'cpu_high' {
        cpus   = { params.threads }
        memory = { params.max_memory }
        time   = { params.max_time }
    }

    withLabel: 'cpu_medium' {
        cpus   = { Math.min(params.threads as int, 32) }
        memory = { params.max_memory }
        time   = { params.max_time }
    }

    withLabel: 'cpu_low' {
        cpus   = 4
        memory = { params.max_memory_low }
        time   = { params.max_time }
    }

    // Process-specific overrides
    withName: 'VCLUST_PREFILTER|VCLUST_ALIGN|VCLUST_PREFILTER_RECLUST|VCLUST_ALIGN_RECLUST' {
        label = 'cpu_high'
    }

    withName: 'MINIMAP2_PAIRWISE' {
        label = 'cpu_high'
    }

    withName: 'BLAST_TRIM:BLASTN|BLAST_TRIM:BLASTN_SECONDARY' {
        label = 'cpu_high'
    }

    withName: 'CHECKV' {
        label = 'cpu_medium'
    }
}

/*
 * wvdb_build pipeline — nextflow.config
 */

params {
    // --- Input / output ---
    fastqdir        = "/path/to/fastq"
    outdir          = "/path/to/workdir"

    // --- Clustering thresholds ---
    ani             = 0.95
    qcov            = 0.85
    completeness    = 90

    // --- Databases ---
    checkvdb          = "/path/to/checkv_db/checkv-db-v1.5"
    refseq_ev_blastdb = "/path/to/esviritu_plus_refseq_virus.fna"
    imgvr_blastdb     = "/path/to/IMG-VR_2025-12-02/IMGVR5_UViG.fna"

    // --- Resources ---
    threads         = 100
    max_memory      = '64 GB'
}

// Load per-process resource config
includeConfig 'conf/base.config'

// Set publishDir subdirectory per step via task.ext.publish_dir.
// DSL2-correct pattern: closures defer evaluation to runtime when task.ext is populated.
process {
    // Step 3 cluster_trim: trim1 checkv + completeness
    withName: 'CLUSTER_TRIM:CHECKV' {
        ext.publish_dir = '3_cluster_trim/checkv_trim1'
    }
    withName: 'CLUSTER_TRIM:CHECKV_TRIM23' {
        ext.publish_dir = '3_cluster_trim/checkv_trim23'
    }
    withName: 'CLUSTER_TRIM:COMPLETENESS_FILTER_TRIM23' {
        ext.publish_dir = '3_cluster_trim'
    }
    withName: 'CLUSTER_TRIM:TRIM_GENOMES|CLUSTER_TRIM:TRIM_GENOMES_13|CLUSTER_TRIM:TRIM_GENOMES_23' {
        ext.publish_dir = '3_cluster_trim'
    }
    // Step 4 blast_trim
    withName: 'BLAST_TRIM:COLLECT_BLAST_INPUT|BLAST_TRIM:BLASTN|BLAST_TRIM:BLASTN_METAVR|BLAST_TRIM:BLASTANI|BLAST_TRIM:BLASTANI_METAVR|BLAST_TRIM:TRIM_GENOMES_BLAST|BLAST_TRIM:TRIM_GENOMES_BLAST_METAVR|BLAST_TRIM:MERGE_BLAST_TRIM|BLAST_TRIM:CHECKV|BLAST_TRIM:COMPLETENESS_FILTER' {
        ext.publish_dir = '4_blast_trim'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    local {
        process.executor = 'local'
        params.threads   = Runtime.runtime.availableProcessors()
        process {
            withLabel: 'cpu_high'   { cpus = Runtime.runtime.availableProcessors(); memory = params.max_memory }
            withLabel: 'cpu_medium' { cpus = Math.max(1, Runtime.runtime.availableProcessors().intdiv(2)); memory = params.max_memory }
            withLabel: 'cpu_low'    { cpus = 2; memory = '8 GB' }
        }
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '-N 1 -t 24:00:00'
        executor.queueSize     = 50
    }

    test {
        process.executor        = 'local'
        params.fastqdir         = "${projectDir}/test/data"
        params.outdir           = "${projectDir}/test/results"
        params.threads          = Runtime.runtime.availableProcessors()
        params.ani              = 0.95
        params.qcov             = 0.85
        params.completeness     = 90
        process {
            withLabel: 'cpu_high'   { cpus = Runtime.runtime.availableProcessors(); memory = '28 GB' }
            withLabel: 'cpu_medium' { cpus = Math.max(1, Runtime.runtime.availableProcessors().intdiv(2)); memory = '14 GB' }
            withLabel: 'cpu_low'    { cpus = 2; memory = '8 GB' }
        }
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
}

manifest {
    name            = 'wvdb_build'
    description     = 'Viral genome database build pipeline'
    version         = '0.1.0'
    nextflowVersion = '>=23.10'
}

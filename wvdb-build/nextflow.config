/*
 * wvdb_build pipeline — nextflow.config
 */

params {
    // --- Input / output ---
    fasta_list      = null         // required: path to text file listing virus/provirus FASTA paths
    outdir          = "/path/to/workdir"

    // --- Clustering thresholds ---
    ani             = 0.95
    qcov            = 0.85
    completeness    = 90

    // --- Databases ---
    checkvdb           = "/path/to/checkv_db/checkv-db-v1.5"

    // BLAST trim databases (paths as strings — index files must be co-located)
    // initial_blastdb: primary reference db (e.g. RefSeq virus + EsViritu)
    // secondary_blastdb: secondary reference db (e.g. IMG-VR v5 / MetaVR)
    initial_blastdb    = null
    secondary_blastdb  = null

    // --- BLAST trim step control ---
    run_initial_blast   = true    // search initial_blastdb
    run_secondary_blast = false   // search secondary_blastdb

    // --- BLAST trim qualifying-hit thresholds ---
    // A hit only proceeds to nucmer trimming if it clears BOTH thresholds.
    // tcov (not qcov) is used since the untrimmed query may be larger than
    // the true genome (chimeric/host-contaminant regions), so full query
    // coverage of the reference hit is not expected. pid ensures trimming
    // only happens against a genuinely homologous (genus-level) reference.
    blast_trim_min_tcov = 85.0     // minimum target coverage %% for a qualifying hit
    blast_trim_min_pid  = 85.0     // minimum percent identity (genus-level) for a qualifying hit

    // Safety margin subtracted from the qualifying/clustering threshold when
    // setting nucmer's show-coords -I filter (per-alignment-block identity).
    // nucmer and blastn/vclust compute identity slightly differently, so a
    // pair sitting right at the threshold could otherwise have its real
    // alignment block rejected by show-coords despite having already
    // qualified upstream. Applied in both blast-trim (85 → 80 by default)
    // and cluster-trim (ani*100=95 → 90 by default) contexts.
    trim_identity_buffer = 5.0

    // --- Whole-genome duplication detection/correction (before final reclustering) ---
    run_deduplication    = true    // detect + correct tandem/inverted whole-genome duplications
    dedup_kmer_threshold = 1.2     // CheckV kmer_freq threshold to flag a candidate
    dedup_min_identity   = 95.0    // min %% identity for a probe hit to count as a repeat copy
    dedup_min_coverage   = 0.90    // min fractional coverage of the probe for a hit to count

    // --- Resources ---
    threads         = 100
    max_memory      = '64 GB'  // high/medium CPU process memory cap
    max_memory_low  = '16 GB'  // low CPU process memory cap
    max_time        = '24 h'   // maximum runtime for any process
    conda_env       = null   // set to path of wvdb_build.yml or env name/prefix to activate per-process
}

// Load per-process resource config
includeConfig 'conf/base.config'

// Set publishDir subdirectory per step via task.ext.publish_dir.
// DSL2-correct pattern: closures defer evaluation to runtime when task.ext is populated.
process {
    // Step 2 clustering
    withName: 'VCLUST_CLUSTER' {
        ext.publish_dir = '2_clustered'
    }
    withName: 'VCLUST_CLUSTER_RECLUST' {
        ext.publish_dir = '5_reclustered'
    }
    // Step 3 cluster_trim
    withName: 'CLUSTER_TRIM:CHECKV' {
        ext.publish_dir = '3_cluster_trim/checkv'
    }
    withName: 'CLUSTER_TRIM:TRIM_GENOMES|CLUSTER_TRIM:TRIM_GENOMES_13|CLUSTER_TRIM:TRIM_GENOMES_23' {
        ext.publish_dir = '3_cluster_trim'
    }
    // Step 4 blast_trim
    withName: 'BLAST_TRIM:COLLECT_BLAST_INPUT|BLAST_TRIM:GET_QUERY_IDS|BLAST_TRIM:BLASTN|BLAST_TRIM:BLASTN_SECONDARY|BLAST_TRIM:BLASTANI|BLAST_TRIM:BLASTANI_SECONDARY|BLAST_TRIM:SELECT_BEST_BLAST_HIT|BLAST_TRIM:TRIM_GENOMES_BLAST|BLAST_TRIM:TRIM_GENOMES_BLAST_SECONDARY|BLAST_TRIM:MERGE_TRIMMED|BLAST_TRIM:CHECKV|BLAST_TRIM:COMPLETENESS_FILTER' {
        ext.publish_dir = '4_blast_trim'
    }
    // Step 5a deduplication (before final reclustering)
    withName: 'CHECKV_PRE_DEDUP' {
        ext.publish_dir = 'dedup/checkv_pre_dedup'
    }
    withName: 'CHECKV_CORRECTED' {
        ext.publish_dir = 'dedup/checkv_corrected'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    local {
        process.executor = 'local'
        params.threads   = Runtime.runtime.availableProcessors()
        process {
            withLabel: 'cpu_high'   { cpus = Runtime.runtime.availableProcessors(); memory = params.max_memory }
            withLabel: 'cpu_medium' { cpus = Math.max(1, Runtime.runtime.availableProcessors().intdiv(2)); memory = params.max_memory }
            withLabel: 'cpu_low'    { cpus = 2; memory = params.max_memory_low }
        }
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '-N 1 -t 24:00:00'
        executor.queueSize     = 50
    }

    // Use -profile slurm_nomem for clusters where DefMemPerNode=UNLIMITED
    // and explicit --mem requests cause submission failures.
    // On these clusters SLURM manages memory allocation automatically.
    slurm_nomem {
        process.executor       = 'slurm'
        process.clusterOptions = '-N 1 -t 24:00:00'
        executor.queueSize     = 50
        process.memory         = null
    }

    // Profile for clusters with 128-CPU / 2TB nodes and one job per node.
    // DefMemPerNode=UNLIMITED so memory requests are omitted.
    // All CPUs on a node are requested per job; SLURM enforces exclusivity.
    // Combine with conda: -profile cluster,conda
    cluster {
        process.executor       = 'slurm'
        process.clusterOptions = '-N 1 --exclusive -t 24:00:00'  // 24h max on these nodes
        executor.queueSize     = 50
        process.memory         = null   // DefMemPerNode=UNLIMITED; omit --mem
        params.threads         = 128
        params.max_memory      = '1900 GB'  // leave headroom below 2TB physical
        params.max_memory_low  = '32 GB'
        params.max_time        = '24 h'
        process {
            withLabel: 'cpu_high'   { cpus = 128 }
            withLabel: 'cpu_medium' { cpus = 64  }
            withLabel: 'cpu_low'    { cpus = 8   }
        }
    }

    // Use -profile conda (alone or combined with slurm) to activate the
    // wvdb-build conda environment for every process. Required when running
    // on a cluster where the env is not inherited from the login shell.
    // Pass --conda_env /path/to/envs/wvdb_build.yml or the env prefix/name.
    conda {
        conda.enabled          = true
        process.conda          = params.conda_env ?: "${projectDir}/envs/wvdb_build.yml"
    }

    test {
        process.executor        = 'local'
        params.fasta_list       = "${projectDir}/test/data/fasta_list.txt"
        params.outdir           = "${projectDir}/test/results"
        params.threads          = Runtime.runtime.availableProcessors()
        params.ani              = 0.95
        params.qcov             = 0.85
        params.completeness     = 90
        process {
            withLabel: 'cpu_high'   { cpus = Runtime.runtime.availableProcessors(); memory = params.max_memory }
            withLabel: 'cpu_medium' { cpus = Math.max(1, Runtime.runtime.availableProcessors().intdiv(2)); memory = params.max_memory }
            withLabel: 'cpu_low'    { cpus = 2; memory = params.max_memory_low }
        }
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
}

manifest {
    name            = 'wvdb_build'
    description     = 'Viral genome database build pipeline'
    version         = '0.1.0'
    nextflowVersion = '>=23.10'
}

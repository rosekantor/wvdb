/*
 * wvdb_annotate pipeline — nextflow.config
 */

params {
    // --- Input / output ---
    input_fasta    = null         // required: path to input vOTU FASTA
    outdir         = null         // required: output directory

    // --- Required databases ---
    checkvdb       = null         // required: CheckV database directory
    genomad_db     = null         // required: geNomad database directory

    // --- Optional databases ---
    rdrpcatch_db   = null         // required if run_rdrpcatch=true
    databases      = null         // unified databases CSV (type,name,path)
                                  //   type: blastn | diamond | hmm
                                  //   blastn,IMGVR,/path/to/IMGVR5_UViG.fna
                                  //   diamond,nr,/path/to/nr.dmnd
                                  //   hmm,pfam,/path/to/Pfam-A.hmm
                                  // only rows whose type has run_<type>=true are executed

    // --- Reference data ---
    prepare_ictv  = false  // set to true to run PREPARE_ICTV and exit
    ictv_raw      = null   // optional: path to manually downloaded ICTV TSV
    ictv_fam      = "${projectDir}/ref_data/ictv_families.tsv"
                           // bundled copy (MSL 2026-01); update with prepare_ictv.py
    entrez_email  = null   // required for Entrez lookups (core_nt BLAST hits)

    // --- Step control ---
    run_rdrpcatch   = true        // scan for RdRP (requires rdrpcatch_db)
    run_blastn      = true        // BLASTn against all databases in blastn_dbs CSV
    run_diamond     = false       // DIAMOND protein search (requires diamond_dbs CSV)
    run_hmmsearch   = false       // hmmsearch against HMM profiles (requires hmm_profiles CSV)
    run_rnavirhost  = true        // host prediction (requires CheckV + geNomad output)
    run_guess_host  = false       // ensemble LLM host prediction (requires merge_annotations output)

    // --- Protein search thresholds ---
    diamond_evalue       = '1e-5' // DIAMOND E-value cutoff
    diamond_min_bitscore = 50     // DIAMOND minimum bitscore
    diamond_max_targets  = 10     // DIAMOND max target sequences per query
    diamond_taxonmap     = false  // include staxids (requires --taxonmap at db build)
    hmm_evalue           = '1e-5' // hmmsearch E-value fallback when --cut_tc unavailable

    // --- Tool paths (override if not in conda env PATH) ---
    rdrpcatch_bin       = "rdrpcatch"  // path to rdrpcatch binary
    // RdRPCATCH runs in its own conda env (Python 3.12 required).
    // Set to the path of the rdrpcatch env yml or prefix.
    rdrpcatch_conda_env  = null  // e.g. '/path/to/conda/envs/rdrpcatch'
                                //   or '${projectDir}/envs/wvdb_rdrpcatch.yml'
    rnavirhost_conda_env = null  // e.g. '/path/to/conda/envs/rnavirhost'
                                //   or '${projectDir}/envs/wvdb_rnavirhost.yml'

    // --- Algorithm thresholds ---
    blastn_evalue       = "1e-3"
    blastn_max_targets  = 10
    blastn_pident       = 90

    // --- Resources ---
    threads         = 100
    max_memory      = '64 GB'
    max_memory_low  = '16 GB'
    max_time        = '24 h'
    conda_env       = null
}

includeConfig 'conf/base.config'

process {
    withName: 'CHECKV' {
        ext.publish_dir = 'checkv'
    }
    withName: 'GENOMAD' {
        ext.publish_dir = 'genomad'
    }
    withName: 'RDRPCATCH' {
        ext.publish_dir = 'rdrpcatch'
        // Override the default conda env for this process
        conda = params.rdrpcatch_conda_env \
            ?: "${projectDir}/envs/wvdb_rdrpcatch.yml"
    }
    withName: 'BLASTN' {
        ext.publish_dir = 'blastn'
    }
    withName: 'BLASTANI' {
        ext.publish_dir = 'blastn'
    }
    withName: 'DIAMOND' {
        ext.publish_dir = 'proteins/diamond'
    }
    withName: 'HMMSEARCH' {
        ext.publish_dir = 'proteins/hmmsearch'
    }
    withName: 'PROTEIN_SUMMARY' {
        ext.publish_dir = 'proteins'
    }
    withName: 'RNAVIRHOST' {
        ext.publish_dir = 'rnavirhost'
        conda = params.rnavirhost_conda_env \
            ?: "${projectDir}/envs/wvdb_rnavirhost.yml"
    }
    withName: 'MERGE_ANNOTATIONS' {
        ext.publish_dir = 'annotations'
    }
    withName: 'GUESS_HOST' {
        ext.publish_dir = 'annotations'
    }
    withName: 'ANNOTATION_SUMMARY' {
        ext.publish_dir = '.'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    local {
        process.executor = 'local'
        // Set threads to available CPUs so base.config cpu_medium cap works correctly
        params.threads   = Runtime.runtime.availableProcessors()
        process {
            withLabel: 'cpu_high'   { cpus = Runtime.runtime.availableProcessors(); memory = params.max_memory }
            withLabel: 'cpu_medium' { cpus = Math.max(1, Runtime.runtime.availableProcessors().intdiv(2)); memory = params.max_memory }
            withLabel: 'cpu_low'    { cpus = Math.min(2, Runtime.runtime.availableProcessors()); memory = params.max_memory_low }
        }
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '-N 1 -t 24:00:00'
        executor.queueSize     = 50
    }

    // For clusters with DefMemPerNode=UNLIMITED — omits --mem from sbatch
    slurm_nomem {
        process.executor       = 'slurm'
        process.clusterOptions = '-N 1 -t 24:00:00'
        executor.queueSize     = 50
        process.memory         = null
    }

    // 128-CPU / 2TB exclusive nodes; DefMemPerNode=UNLIMITED
    cluster {
        process.executor       = 'slurm'
        process.clusterOptions = '-N 1 --exclusive -t 24:00:00'
        executor.queueSize     = 50
        process.memory         = null
        params.threads         = 128
        params.max_memory      = '1900 GB'
        params.max_memory_low  = '32 GB'
        params.max_time        = '24 h'
        process {
            withLabel: 'cpu_high'   { cpus = 128 }
            withLabel: 'cpu_medium' { cpus = 64  }
            withLabel: 'cpu_low'    { cpus = 8   }
        }
    }

    conda {
        conda.enabled  = true
        process.conda  = params.conda_env ?: "${projectDir}/envs/wvdb_annotate.yml"
    }

    test {
        process.executor        = 'local'
        params.input_fasta      = "${projectDir}/test/data/test_votus.fasta"
        params.outdir           = "${projectDir}/test/results"
        params.threads          = Runtime.runtime.availableProcessors()
        process {
            withLabel: 'cpu_high'   { cpus = Runtime.runtime.availableProcessors(); memory = params.max_memory }
            withLabel: 'cpu_medium' { cpus = Math.max(1, Runtime.runtime.availableProcessors().intdiv(2)); memory = params.max_memory }
            withLabel: 'cpu_low'    { cpus = 2; memory = params.max_memory_low }
        }
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
}

manifest {
    name            = 'wvdb_annotate'
    description     = 'Viral genome annotation pipeline (wvdb_annotate)'
    version         = '0.1.0'
    nextflowVersion = '>=23.10'
}

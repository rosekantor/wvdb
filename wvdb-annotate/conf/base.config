/*
 * conf/base.config
 * Per-process CPU / memory defaults for wvdb_annotate.
 *
 * During stub runs, memory is set to 1 GB to avoid hardware limit errors
 * on development machines. CPU counts are also capped at available processors.
 *
 * Override memory at runtime:
 *   --max_memory      caps high/medium processes  (default: 64 GB)
 *   --max_memory_low  caps low-CPU processes       (default: 16 GB)
 *   --max_time        caps all process runtimes    (default: 24 h)
 */

process {
    cpus   = 2
    memory = { workflow.stubRun ? '1 GB' : params.max_memory_low }
    time   = { params.max_time }

    // Default: let already-running processes finish rather than killing
    // them immediately on an unrelated failure (Nextflow default is
    // 'terminate', which kills all running tasks on any process error).
    // Override per-process with errorStrategy if a specific step should
    // retry or be ignored instead.
    errorStrategy = 'finish'

    withLabel: 'cpu_high' {
        cpus   = { workflow.stubRun ? 1 : params.threads }
        memory = { workflow.stubRun ? '1 GB' : params.max_memory }
        time   = { params.max_time }
    }

    withLabel: 'cpu_medium' {
        cpus   = { workflow.stubRun ? 1 : Math.min(params.threads as int, Runtime.runtime.availableProcessors()) }
        memory = { workflow.stubRun ? '1 GB' : params.max_memory }
        time   = { params.max_time }
    }

    withLabel: 'cpu_low' {
        cpus   = { workflow.stubRun ? 1 : 4 }
        memory = { workflow.stubRun ? '1 GB' : params.max_memory_low }
        time   = { params.max_time }
    }

    // Process-specific overrides
    withName: 'CHECKV' {
        label = 'cpu_medium'
    }

    withName: 'GENOMAD' {
        label = 'cpu_high'
    }

    withName: 'RDRPCATCH' {
        label = 'cpu_high'
    }

    withName: 'BLASTN' {
        label = 'cpu_high'
    }

    withName: 'DIAMOND' {
        label = 'cpu_high'
    }

    withName: 'RNAVIRHOST' {
        label = 'cpu_medium'
    }
}

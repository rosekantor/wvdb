/*
 * conf/base.config
 * Per-process CPU / memory defaults for wvdb_annotate.
 *
 * All memory and time values driven by params — override at runtime:
 *   --max_memory      caps high/medium processes  (default: 64 GB)
 *   --max_memory_low  caps low-CPU processes       (default: 16 GB)
 *   --max_time        caps all process runtimes    (default: 24 h)
 */

process {
    cpus   = 2
    memory = { params.max_memory_low }
    time   = { params.max_time }

    withLabel: 'cpu_high' {
        cpus   = { params.threads }
        memory = { params.max_memory }
        time   = { params.max_time }
    }

    withLabel: 'cpu_medium' {
        cpus   = { Math.min(params.threads as int, 32) }
        memory = { params.max_memory }
        time   = { params.max_time }
    }

    withLabel: 'cpu_low' {
        cpus   = 4
        memory = { params.max_memory_low }
        time   = { params.max_time }
    }

    // Process-specific overrides
    withName: 'CHECKV' {
        label = 'cpu_medium'
    }

    withName: 'GENOMAD' {
        label = 'cpu_high'
    }

    withName: 'RDRPCATCH' {
        label = 'cpu_high'
    }

    withName: 'BLASTN' {
        label = 'cpu_high'
    }

    withName: 'DIAMOND' {
        label = 'cpu_high'
    }

    withName: 'RNAVIRHOST' {
        label = 'cpu_medium'
    }
}

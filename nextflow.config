/*
 * wf3 pipeline — nextflow.config
 * Translated from params_wf3.sh
 */

params {
    // --- Input / output ---
    fastqdir        = "/path/to/fastq"          // top-level dir used by wf2 (contains <sample>/assembly/<run>/filtered_*.fasta)
    outdir          = "/path/to/workdir"

    // --- Clustering thresholds ---
    ani             = 0.95
    qcov            = 0.85
    completeness    = 90                        // minimum CheckV completeness (%)

    // --- Databases ---
    checkvdb        = "/path/to/checkv_db/checkv-db-v1.5"
    refseq_ev_blastdb = "/path/to/esviritu_plus_refseq_virus.fna"
    imgvr_blastdb   = "/path/to/IMG-VR_2025-12-02/IMGVR5_UViG.fna"

    // --- Resources (override per-process in conf/base.config) ---
    threads         = 100
    max_memory      = '64 GB'   // override with e.g. --max_memory '32 GB' for local runs
}

// Load per-process resource config
includeConfig 'conf/base.config'

// Set publishDir subdirectory per branch via task.ext.publish_dir.
// This is the DSL2-correct way to pass dynamic values into directives.
process {
    withName: 'BRANCH_A:PARSE_CLUSTERS|BRANCH_A:TRIM_GENOMES|BRANCH_A:CHECKV|BRANCH_A:COMPLETENESS_FILTER' {
        ext.publish_dir = '3_branchA'
    }
    withName: 'BRANCH_B:PARSE_CLUSTERS|BRANCH_B:TRIM_GENOMES|BRANCH_B:CHECKV|BRANCH_B:COMPLETENESS_FILTER' {
        ext.publish_dir = '4_branchB'
    }
    withName: 'BRANCH_C:COLLECT_BRANCHC|BRANCH_C:BLASTN|BRANCH_C:BLASTN_METAVR|BRANCH_C:BLASTANI|BRANCH_C:BLASTANI_METAVR|BRANCH_C:TRIM_GENOMES_BLAST|BRANCH_C:TRIM_GENOMES_BLAST_METAVR|BRANCH_C:MERGE_BRANCHC|BRANCH_C:CHECKV|BRANCH_C:COMPLETENESS_FILTER' {
        ext.publish_dir = '5_branchC'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    // Use -profile local for development on a laptop/workstation.
    // Caps CPUs per process at the machine's available core count and
    // overrides params.threads to match, so cpu_high processes don't
    // request more CPUs than the machine has.
    local {
        process.executor = 'local'
        params.threads   = Runtime.runtime.availableProcessors()
        process {
            withLabel: 'cpu_high'   { cpus = Runtime.runtime.availableProcessors(); memory = params.max_memory }
            withLabel: 'cpu_medium' { cpus = Math.max(1, Runtime.runtime.availableProcessors().intdiv(2)); memory = params.max_memory }
            withLabel: 'cpu_low'    { cpus = 2; memory = '8 GB' }
        }
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '-N 1 -t 24:00:00'
        executor.queueSize     = 50
    }

    // test profile: small data paths + local resource caps for CI / stub runs
    test {
        process.executor        = 'local'
        params.fastqdir         = "${projectDir}/test/data"
        params.outdir           = "${projectDir}/test/results"
        params.threads          = Runtime.runtime.availableProcessors()
        params.ani              = 0.95
        params.qcov             = 0.85
        params.completeness     = 90
        process {
            withLabel: 'cpu_high'   { cpus = Runtime.runtime.availableProcessors(); memory = '28 GB' }
            withLabel: 'cpu_medium' { cpus = Math.max(1, Runtime.runtime.availableProcessors().intdiv(2)); memory = '14 GB' }
            withLabel: 'cpu_low'    { cpus = 2; memory = '8 GB' }
        }
    }
}

// Capture nextflow run metadata
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
}

manifest {
    name        = 'wf3-pipeline'
    description = 'Viral genome clustering and trimming pipeline'
    version     = '0.1.0'
    nextflowVersion = '>=23.10'
}
